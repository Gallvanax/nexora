# ==========================================
# NEXORA — Configuration d'environnement
# ==========================================
# Copiez ce fichier vers `.env` et renseignez vos valeurs réelles.
# Ne commitez JAMAIS votre fichier `.env` contenant de vrais secrets.

# --- Base de données PostgreSQL ---
# En développement local rapide avec Prisma Postgres : lancez `npx prisma dev`
# En production / Docker : chaîne PostgreSQL standard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora?schema=public"

# --- Sécurité & Sessions (OBLIGATOIRE) ---
# Générez une clé aléatoire d'au moins 32 octets : openssl rand -hex 32
AUTH_SECRET="remplacez-moi-par-une-cle-aleatoire-securisee-de-64-caracteres-minimum"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Connexion Google OAuth (OPTIONNEL) ---
# Laissez vide pour désactiver le bouton Google OAuth proprement
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- E-mails transactionnels SMTP (OPTIONNEL) ---
# Si non configuré, les liens de vérification / réinitialisation sont journalisés en mode dev sécurisé
# et aucun e-mail réel n'est prétendu envoyé en production.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NEXORA <noreply@nexora.local>"

# --- Stockage de fichiers S3-compatible (OPTIONNEL) ---
# Si non configuré, les pièces jointes privées sont stockées hors du dossier public (./storage/uploads)
# et servies uniquement via une route API authentifiée et autorisée (/api/attachments/[id]).
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Assistant intelligent (OPTIONNEL — Architecture prête pour extension) ---
# Aucun fournisseur d'IA n'est simulé si cette clé est absente.
AI_PROVIDER_API_KEY=""
